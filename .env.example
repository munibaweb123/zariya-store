# Copy this file to .env.local and fill in real values. .env.local is
# gitignored — never commit real credentials.

# --- Neon Postgres (orders) -------------------------------------------------

# Pooled connection string — used by the running app (lib/prisma.ts).
# Neon dashboard → your project → Connect → "Pooled connection".
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Direct (non-pooled) connection string — used only by the Prisma CLI for
# migrations (prisma.config.ts). Migrations run DDL/advisory locks that don't
# work reliably through PgBouncer transaction-mode pooling.
# Neon dashboard → your project → Connect → "Direct connection".
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"

# --- Sanity (product content) ----------------------------------------------

# Sanity dashboard (sanity.io/manage) → your project → Project ID.
NEXT_PUBLIC_SANITY_PROJECT_ID="your-project-id"

# The dataset to read from. "development" for local work; a separate
# "production" dataset should exist before going live.
NEXT_PUBLIC_SANITY_DATASET="development"

# Pin to a fixed date — never "latest" — so Sanity API changes can't silently
# break queries. Any valid past date works; just don't change it casually.
NEXT_PUBLIC_SANITY_API_VERSION="2025-06-01"

# Server-only token for authenticated Sanity operations (not used by the
# public read queries in lib/sanity/queries.ts, which read the dataset
# anonymously — reserved for future authenticated server-side needs).
# Sanity dashboard → API → Tokens → Add API token.
SANITY_API_TOKEN=""

# Separate, seed-only token with write access — used exclusively by
# scripts/seed.ts. Never reused as SANITY_API_TOKEN or vice versa.
# Sanity dashboard → API → Tokens → Add API token (Editor permission is enough).
SANITY_SEED_TOKEN=""
